// Description text in a dialog window
// en: "Go to System Setting → Privacy & Security → Contacts to grant Glyphs access to your contacts."
"access-prompt.description" = "前往系統設定 → 隱私權與安全性 → 聯絡人，允許 Glyphs 存取您的聯絡人。";

// Title of a dialog window
// en: "Glyphs cannot access your contacts"
"access-prompt.title" = "Glyphs 無法存取您的聯絡人";

// Label for a section in the settings window for configuring whether to load profile pictures from the Contacts app
// en: "Contacts:"
"access.contacts.label" = "聯絡人：";

// Button title for allowing access to the Contacts app
// en: "Allow Access to Contacts"
"access.contacts.toggle.title" = "允許存取聯絡人";

// Explanation of the GitHub service
// en: "If checked, Light Table sends email addresses to the service GitHub.com. If a user is registered at GitHub with a matching email address, Light Table can load and show their GitHub profile picture. GitHub is a subsidiary of Microsoft Corporation."
"access.github.description" = "如果勾選，Light Table 會將電子郵件地址傳送到 GitHub.com 服務。若使用者在 GitHub 上註冊了相符的電子郵件地址，Light Table 可以載入並顯示其 GitHub 個人頭像。GitHub 是微軟公司的子公司。";

// Link to the GitHub Privacy Statement webpage
// en: "GitHub Privacy Statement"
"access.github.info-link.title" = "GitHub 隱私權聲明";

// Label for a section in the settings window for configuring whether to load profile pictures from GitHub.com
// en: "GitHub:"
"access.github.label" = "GitHub：";

// Button title for allowing access to GitHub.com
// en: "Allow loading profile pictures from GitHub"
"access.github.toggle.title" = "允許從 GitHub 載入個人頭像";

// Explanation of the Gravatar service
// en: "If checked, Light Table sends email addresses in a hashed from to the service Gravatar.com. If a user is registered at Gravatar with a matching email address, Light Table can load and show their Gravatar profile picture. Gravatar is a venture by Automattic Inc."
"access.gravatar.description" = "如果勾選，Light Table 會以雜湊形式將電子郵件地址傳送到 Gravatar.com 服務。若使用者在 Gravatar 上註冊了相符的電子郵件地址，Light Table 可以載入並顯示其 Gravatar 個人頭像。Gravatar 是 Automattic Inc. 的事業部門。";

// Link to the Gravatar Data Privacy webpage
// en: "Gravatar Data Privacy"
"access.gravatar.info-link.title" = "Gravatar 資料隱私權";

// Label for a section in the settings window for configuring whether to load profile pictures from Gravatar.com
// en: "Gravatar:"
"access.gravatar.label" = "Gravatar：";

// Button title for allowing access to Gravatar.com
// en: "Allow loading profile pictures from Gravatar"
"access.gravatar.toggle.title" = "允許從 Gravatar 載入個人頭像";

