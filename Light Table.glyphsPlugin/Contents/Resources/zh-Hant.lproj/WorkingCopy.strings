// A qualifier that is appended to the title of an app name to mark the app as the default app for opening a file
// en: " (Default)"
"app-title.qualifier.default" = "（預設）";

// A version number that is appended to the title of an app name
// en: " (%@)"
"app-title.qualifier.version" = "（%@）";

// Title of a button that create a new version
// en: "Create Version"
"commit-button.commit.title" = "建立版本";

// A short placeholder text that invites the user to optionally describe the current changes to the project in more detail
// en: "Optionally, add more details here"
"commit-message.details.placeholder" = "選填：詳細說明";

// A short placeholder text that invites the user to briefly describe the current changes to the project
// en: "Short description of what changed"
"commit-message.summary.placeholder" = "變更摘要";

// Title of a button that includes all changes in the next version
// en: "Stage All"
"complete-staging-button.stage-all.title" = "全部暫存";

// Title of a button that excludes all changes from the next version
// en: "Unstage All"
"complete-staging-button.unstage-all.title" = "全部取消暫存";

// Placeholder text that is shown when a folder is selected
// en: "Folder Contains Changes"
"details.placeholder.folder-contains-changes" = "資料夾包含變更";

// Placeholder text that is shown when a Glyphs Package (.glyphspackage) is selected
// en: "Glyphs Package Contains Changes"
"details.placeholder.glyphspackage-contains-changes" = "Glyphs 套件包含變更";

// Placeholder text that is shown when a no file is selected in the files list
// en: "No File Selected"
"details.placeholder.no-file-selected" = "未選擇檔案";

// Placeholder text that is shown when the diff of a file is loading
// en: "Comparing…"
"details.placeholder.progress" = "比較中…";

// Table column title for a list of files
// en: "File"
"file-list.columns.file.title" = "檔案";

// Table column title for a list of status information (staged/unstaged file)
// en: "Status"
"file-list.columns.status.title" = "狀態";

// Placeholder text that is shown when no files have changed since the latest version
// en: "No Changes"
"file-list.placeholder.no-changes" = "無變更";

// Placeholder text that is shown when no file matches the current file filter or search query
// en: "No Matching Files"
"file-list.placeholder.no-filter-match" = "沒有符合的檔案";

// Tooltip for a button that toggles whether only staged changes should be shown
// en: "Show only staged changes"
"filter.staging.x.tooltip" = "僅顯示已暫存的變更";
