// Error message when the user tried to use a folder that is not a Git repository.
// en: "Cannot open Git repository at path."
"error.cannot-open-repository-at-path" = "無法在此路徑開啟 Git 儲存庫。";

// A generic error message shown when no Git repository is set up.
